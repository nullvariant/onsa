{
	"name": "@nullvariant/onsa",
	"private": true,
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "bash -c 'if find packages -name \"*.ts\" -o -name \"*.mts\" | grep -q .; then tsc --noEmit; else echo \"typecheck: skipped (no .ts inputs)\"; fi'"
	},
	"devDependencies": {
		"@nullvariant/onsa-biome-config": "workspace:*",
		"@nullvariant/onsa-eslint-config": "workspace:*",
		"@nullvariant/onsa-htmlhint-config": "workspace:*",
		"@nullvariant/onsa-stylelint-config": "workspace:*",
		"@nullvariant/onsa-tsconfig": "workspace:*",
		"@types/htmlhint": "^1.1.5",
		"@types/node": "^24.0.3",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "^10.3.0",
		"typescript": "^6.0.3",
		"vitest": "^3.2.4",
		"yaml": "^2.9.0"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint-plugin-jsx-a11y": {
					"eslint": ">=10"
				}
			}
		}
	}
}
